DATABASE_URL=postgresql://munim:munim@localhost:5433/munim

CONTINUUM_URL=http://localhost:8000
CONTINUUM_API_KEY=

# Meta WhatsApp Cloud API
WA_VERIFY_TOKEN=change-me
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=


# OpenAI-compatible endpoint (default model: glm5.3-flash). Empty = heuristic fallbacks.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm5.3-flash
# Used only for multi-hop reconciliation
LLM_REASONING_MODEL=
SARVAM_API_KEY=
TICK_SECONDS=60
DIGEST_HOUR_IST=9

# Approved Meta template for reminders outside the 24h window (empty = text only)
WA_REMINDER_TEMPLATE=
WA_REMINDER_LANG=en

# Public https origin (e.g. your tunnel URL); enables tappable pay links
PUBLIC_BASE_URL=

# Production compose only: password for the munim_postgres container
MUNIM_DB_PASSWORD=

# Approved template for the owner when their 24h window is closed; body has one variable: items waiting
WA_OWNER_TEMPLATE=
# Telegram owner channel (from @BotFather); secret is any random string, set by scripts/telegram_setup.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Model for the agent tool loop (defaults to LLM_MODEL); pick via evals/agent_harness.py
LLM_AGENT_MODEL=
# Python sandbox: container in production (munim_sandbox), local for dev only
SANDBOX_MODE=local
SANDBOX_JOBS_DIR=./data/sandbox-jobs
