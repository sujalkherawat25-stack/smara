# Use a server-side Syntarus project key. Never expose it to clients.
SYNTARUS_API_KEY=sk_mem_replace_me
SYNTARUS_BASE_URL=https://ai.syntarus.com/v1
SMARA_DATABASE_URL=postgresql://smara:change-me@postgres:5432/smara
SMARA_DATABASE_PATH=./data/smara.db
SMARA_BIND_ADDRESS=127.0.0.1
SMARA_HOST_PORT=8090
# Development only. Production requests must arrive through an authenticated
# Smara gateway which supplies a verified account id.
SMARA_DEV_MODE=true
# In production, an authenticated Smara gateway verifies the session/JWT and
# signs `timestamp.account_id` before forwarding the request to this API.
SMARA_GATEWAY_SIGNING_SECRET=replace-with-a-long-random-secret
# Required before Smara can accept integration credentials. Store this in your
# deployment secret manager; changing it without a rotation plan makes existing
# encrypted credentials unreadable.
SMARA_INTEGRATION_MASTER_KEY=replace-with-a-fernet-key
# Rotation: prepend the new key, keep the old one until all credentials have
# been read and re-encrypted by the integration worker, then remove it.
SMARA_INTEGRATION_MASTER_KEYS=
SMARA_PUBLIC_BASE_URL=https://smara.example.com
# Required only when enabling the matching OAuth connection buttons.
SMARA_GOOGLE_CLIENT_ID=
SMARA_GOOGLE_CLIENT_SECRET=
SMARA_GITHUB_CLIENT_ID=
SMARA_GITHUB_CLIENT_SECRET=
# Enable Web Push for the installed phone PWA. Generate/store these only in
# deployment secrets; the public key is intentionally safe to return to phones.
SMARA_VAPID_PUBLIC_KEY=
SMARA_VAPID_PRIVATE_KEY=
SMARA_VAPID_SUBJECT=mailto:admin@example.com
SMARA_RATE_LIMIT_PER_MINUTE=120
# Required outside development: all API replicas use this Redis bucket.
SMARA_REDIS_URL=redis://redis:6379/0
# Optional error reporting. No events leave this process when it is empty.
SMARA_SENTRY_DSN=
