# Smara performance rollout switches. These are independent kill switches:
# disabling one preserves the durable task, approval, event, and account data.
SMARA_FAST_ROUTING_ENABLED=true
SMARA_POOLED_RESOURCES_ENABLED=true
SMARA_WORK_SIGNALS_ENABLED=true
SMARA_DESKTOP_LONG_POLL_ENABLED=true
SMARA_SHADOW_ROUTING_ENABLED=false
SMARA_WORKER_CONCURRENCY=4

# Roll back one optimization without rebuilding:
# SMARA_FAST_ROUTING_ENABLED=false
# SMARA_POOLED_RESOURCES_ENABLED=false
# SMARA_WORK_SIGNALS_ENABLED=false
# SMARA_DESKTOP_LONG_POLL_ENABLED=false
# SMARA_WORKER_CONCURRENCY=1
