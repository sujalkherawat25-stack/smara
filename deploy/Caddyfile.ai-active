# MemoryOS — Caddy TLS config for ai.syntarus.com
#
# Caddy auto-provisions and renews the Let's Encrypt certificate.
#
# To activate on the Oracle server:
#   1. Add DNS A record: ai → <oracle-ip>  (in your DNS provider)
#   2. sudo ln -sf ~/memoryos/caddy/Caddyfile /etc/caddy/Caddyfile
#   3. sudo systemctl enable --now caddy
#   4. ./scripts/deploy.sh --tls

ai.syntarus.com {
    # Reversible Smara staging mount. Caddy strips the public prefixes so the
    # browser keeps the ai.syntarus.com session while Smara receives /v1/*.
    handle_path /smara-api/* {
        reverse_proxy 127.0.0.1:8090 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
            flush_interval -1
            transport http {
                read_timeout  1h
                write_timeout 1h
            }
        }
    }

    handle_path /smara/* {
        reverse_proxy 127.0.0.1:8081 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Existing Memento app remains the root catch-all.
    handle {
        # The existing Memento frontend is published by Docker on 127.0.0.1:8080.
        reverse_proxy 127.0.0.1:8080 {
            # Pass real IP so backend logs are accurate
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # SSE: flush immediately, keep connection alive for up to 1h
            flush_interval -1
            transport http {
                read_timeout  1h
                write_timeout 1h
            }
        }
    }

    # Compress responses
    encode gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        # Allow embedding the app via <iframe> on the syntarus marketing site.
        # frame-ancestors (CSP) supersedes the old X-Frame-Options: SAMEORIGIN,
        # which would otherwise block the iframe on www.syntarus.com.
        Content-Security-Policy   "frame-ancestors 'self' https://www.syntarus.com https://syntarus.com"
        Referrer-Policy           "strict-origin-when-cross-origin"
    }

    # Caddy logs
    log {
        output file /var/log/caddy/memoryos.log {
            roll_size     50mb
            roll_keep     5
        }
        level INFO
    }
}


bridge.syntarus.com {
    reverse_proxy 127.0.0.1:8787
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}


control-staging.syntarus.com {
    reverse_proxy 127.0.0.1:8090 {
        header_up X-Real-IP {remote_host}
    }
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "frame-ancestors https://ai.syntarus.com"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    log {
        output file /var/log/caddy/smara-control-staging.log {
            roll_size 50mb
            roll_keep 5
        }
    }
}
