# MemoryOS — Caddy TLS config for ai.syntarus.com
#
# Caddy auto-provisions and renews the Let's Encrypt certificate.
#
# To activate on the Oracle server:
#   1. Add DNS A record: ai → <oracle-ip>  (in your DNS provider)
#   2. sudo ln -sf ~/memoryos/caddy/Caddyfile /etc/caddy/Caddyfile
#   3. sudo systemctl enable --now caddy
#   4. ./scripts/deploy.sh --tls

# Keep the Syntarus marketing site available while Smara owns the AI app.
# Cloudflare terminates at this host, then Caddy presents the origin certificate
# for both apex and www and forwards to the existing static-site container.
syntarus.com, www.syntarus.com {
    reverse_proxy 127.0.0.1:8082 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy            "strict-origin-when-cross-origin"
    }
    log {
        output file /var/log/caddy/syntarus-site.log {
            roll_size 50mb
            roll_keep 5
        }
        level INFO
    }
}

ai.syntarus.com {
    # Smara owns the canonical public root. The API keeps a distinct prefix so
    # it cannot collide with the legacy MemoryOS/Memento /v1/* bridge routes.
    # The canonical Smara UI is served at /. Keep the former mount explicit
    # and gone so stale bookmarks do not silently render a second shell.
    @retired_smara path /smara /smara/*
    handle @retired_smara {
        respond "Smara is now available at https://ai.syntarus.com/" 410
    }
    @smara_api_base path /smara-api
    handle @smara_api_base {
        redir @smara_api_base /smara-api/ 308
    }
    handle_path /smara-api/* {
        reverse_proxy 127.0.0.1:8090 {
            header_up X-Real-IP {remote_host}
            header_down X-Syntarus-Service "smara-agent"
            flush_interval -1
            transport http {
                read_timeout  1h
                write_timeout 1h
            }
        }
    }

    # Canonical Syntarus Memory API prefix. Its edge namespace is separate
    # from Smara and is rewritten only to the legacy MemoryOS backend.
    @syntarus_api_base path /syntarus-api
    handle @syntarus_api_base {
        redir /syntarus-api/ 308
    }
    @syntarus_api_health path /syntarus-api/health
    handle @syntarus_api_health {
        uri replace /syntarus-api/health /health
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Real-IP {remote_host}
            header_down X-Syntarus-Service "memory-api"
        }
    }
    @syntarus_api path /syntarus-api/*
    handle @syntarus_api {
        uri replace /syntarus-api /v1
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Real-IP {remote_host}
            header_down X-Syntarus-Service "memory-api"
            flush_interval -1
            transport http {
                read_timeout 1h
                write_timeout 1h
            }
        }
    }

    # The old Memento agent runtime is retired. Native Smara auth/chat/task
    # routes live under /smara-api; return a clear, deterministic response for
    # stale Memento bookmarks instead of forwarding them to the old process.
    @retired_memento path /v1/memento /v1/memento/*
    handle @retired_memento {
        respond "The Memento agent runtime has moved to Smara." 410
    }
    @retired_memento_auth path /v1/auth /v1/auth/*
    handle @retired_memento_auth {
        respond "Smara sign-in is available at https://ai.syntarus.com/" 410
    }

    # Transitional alias for developer bundles cached before the explicit
    # /syntarus-api namespace shipped. Keep it pointed only at Syntarus.
    @developer_portal_auth_legacy path /v1/portal-auth/*
    handle @developer_portal_auth_legacy {
        uri replace /v1/portal-auth /v1
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Real-IP {remote_host}
            header_down X-Syntarus-Service "memory-api"
            flush_interval -1
            transport http {
                read_timeout 1h
                write_timeout 1h
            }
        }
    }

    # MemoryOS remains available as the core memory/public API. This fallback
    # does not expose the retired Memento namespace above.
    handle /v1/* {
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Real-IP {remote_host}
            header_down X-Syntarus-Service "memory-api"
            flush_interval -1
            transport http {
                read_timeout 1h
                write_timeout 1h
            }
        }
    }

    handle {
        reverse_proxy 127.0.0.1:8081 {
            header_up X-Real-IP {remote_host}
            header_down X-Syntarus-Service "smara-agent"
            flush_interval -1
            transport http {
                read_timeout 1h
                write_timeout 1h
            }
        }
    }

    # Compress responses
    encode gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        # Allow embedding the app via <iframe> on the syntarus marketing site.
        # frame-ancestors (CSP) supersedes the old X-Frame-Options: SAMEORIGIN,
        # which would otherwise block the iframe on www.syntarus.com.
        Content-Security-Policy   "frame-ancestors 'self' https://www.syntarus.com https://syntarus.com"
        Referrer-Policy           "strict-origin-when-cross-origin"
    }

    # Caddy logs
    log {
        output file /var/log/caddy/memoryos.log {
            roll_size     50mb
            roll_keep     5
        }
        level INFO
    }
}


bridge.syntarus.com {
    reverse_proxy 127.0.0.1:8787
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
