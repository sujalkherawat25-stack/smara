{
  "manifest_version": 3,
  "name": "Smara",
  "version": "1.0.0",
  "description": "Lets Smara Desktop work in your own browser, in its own tabs, with your sign-ins. It never touches your other tabs.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Smara", "default_popup": "popup.html" }
}
