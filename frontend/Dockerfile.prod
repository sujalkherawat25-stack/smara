FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_SMARA_MODE=true
ARG VITE_SMARA_API_URL=/smara-api
ARG VITE_SMARA_CONTROL_TOKEN_PATH=/v1/auth/control-token
ARG VITE_BASE_PATH=/
ENV VITE_SMARA_MODE=$VITE_SMARA_MODE \
    VITE_SMARA_API_URL=$VITE_SMARA_API_URL \
    VITE_SMARA_CONTROL_TOKEN_PATH=$VITE_SMARA_CONTROL_TOKEN_PATH \
    VITE_BASE_PATH=$VITE_BASE_PATH
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
