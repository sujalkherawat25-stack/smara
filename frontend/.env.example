# Transitional P0 migration mode. Keep false until the shell is verified.
VITE_SMARA_MODE=false
# Same-origin staging mount on ai.syntarus.com. The API proxy strips this
# prefix before forwarding to the Smara API container.
VITE_BASE_PATH=/smara/
VITE_SMARA_API_URL=/smara-api
VITE_SMARA_CONTROL_TOKEN_PATH=/v1/auth/control-token
