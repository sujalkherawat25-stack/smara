DATABASE_URL=postgresql://smara:smara@localhost:5433/smara

CONTINUUM_URL=http://localhost:8000
CONTINUUM_API_KEY=

# Meta WhatsApp Cloud API
WA_VERIFY_TOKEN=change-me
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=


# OpenAI-compatible endpoint (default model: glm5.3-flash). Empty = heuristic fallbacks.
LLM_BASE_URL=
LLM_API_KEY=
# Optional: several keys for the same endpoint, comma-separated (placeholders, not real keys). When set it replaces
# LLM_API_KEY; each key has its own requests-per-minute budget, so N keys serve about N times the calls.
LLM_API_KEYS=
LLM_MODEL=glm5.3-flash
# Used only for multi-hop reconciliation
LLM_REASONING_MODEL=
# Voice notes (owner and customers) use Sarvam speech-to-text. Empty key = voice notes are off and the owner is told so.
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
# Files the owner sends (any type, up to 20 MB) are kept here for 7 days, one folder per shop, outside the database.
# In the container, mount a host folder at this path so files survive a container rebuild (default: ./data/owner-files).
# OWNER_FILES_DIR=/app/data/owner-files
# Reminder sending: "own" = the owner sends each approved reminder from their own WhatsApp (wa.me link, default);
# "smara" = sent from Smara's number (needs approved templates and customers who reply to it)
REMINDER_SEND_MODE=own
# Shops (comma-separated shop ids, or *) that may browse and reach files through their own paired PC. Unset = none: every
# shop browses with Smara's cloud browser and is never asked to pair a PC (until Smara Desktop is released).
PC_BROWSER_TENANTS=
# OPS_TELEGRAM_CHAT_ID also gets an hourly error report (no model, no tokens) when exceptions or tool failures happened;
# nothing is sent in an hour without errors, and nothing during QUIET_HOURS_IST (the night's report comes in the morning).
TICK_SECONDS=60
DIGEST_HOUR_IST=9

# Approved Meta template for reminders outside the 24h window (empty = text only)
WA_REMINDER_TEMPLATE=
WA_REMINDER_LANG=en

# Public https origin (e.g. your tunnel URL); enables tappable pay links
PUBLIC_BASE_URL=

# Production compose only: password for the smara_postgres container
SMARA_DB_PASSWORD=

# Approved template for the owner when their 24h window is closed; body has one variable: items waiting
WA_OWNER_TEMPLATE=
# Telegram owner channel (from @BotFather); secret is any random string, set by scripts/telegram_setup.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Model for the agent tool loop (defaults to LLM_MODEL); pick via evals/agent_harness.py
LLM_AGENT_MODEL=
# Pacing of agent calls to the provider (measured: one key allows about 60-100 calls a minute, shared by both models).
# Sarvam, one key: the values below. Leave them commented out for the defaults. With N keys in LLM_API_KEYS raise RPM and BURST about N times.
# LLM_AGENT_RPM=55
# LLM_AGENT_BURST=30
# LLM_MAX_CONCURRENCY=12
# LLM_FALLBACK_ON_BUSY=0
# Python sandbox: container in production (smara_sandbox), local for dev only
SANDBOX_MODE=local
SANDBOX_JOBS_DIR=./data/sandbox-jobs

# Nothing proactive is sent between these IST hours (cards wait, digests only 9-12, approved sends defer)
QUIET_HOURS_IST=21-8

# A shop's OWN WhatsApp number through the Baileys link (server/wa_link). UNOFFICIAL: WhatsApp can restrict the number.
# Empty WA_LINK_URL = off (only the Cloud API paths run). In production put the token in a secret file instead
# (secrets/wa_link_token, mounted as /run/secrets/wa_link_token) and set WA_LINK_TOKEN_FILE; it is never printed.
# Pilot: set REMINDER_SEND_MODE=smara above, or the SIM link never sends customer messages (own mode is server-wide).
WA_LINK_URL=
WA_LINK_TOKEN=
WA_LINK_DAILY_CAP=40
WA_LINK_SEND_GAP_S=6
