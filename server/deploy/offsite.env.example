# Copy to /etc/smara-offsite/offsite.env on the server (root-only, chmod 600). Not in git.
# rclone remote name must match rclone.conf in /root/.config/rclone/ (root-only).
OFFSITE_DEST=r2:smara-offsite-backups
# Fingerprint of the backup PUBLIC key (imported into root's gpg keyring). The private key is never on the server.
GPG_RECIPIENT=C05FC90B8EDC2224537E80B8D622576C38F47AFD
